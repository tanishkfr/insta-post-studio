{
  "name": "bend-motion-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BEND. — a local-first experimental video and motion studio.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:phase2a1": "playwright test tests/browser/accessibility.spec.ts tests/browser/capabilities.spec.ts tests/browser/phase2a1.spec.ts tests/browser/timing.spec.ts",
    "identity:source": "node scripts/source-identity.mjs",
    "identity:deployment": "node scripts/deployment-identity.mjs",
    "test:deployed:smoke": "playwright test -c playwright.deployed.config.ts --grep @smoke",
    "test:deployed:full": "playwright test -c playwright.deployed.config.ts --project=chrome --grep @full",
    "test:deployed:creator": "playwright test -c playwright.deployed.config.ts --project=chrome --grep @creator",
    "test:deployed:host": "playwright test -c playwright.deployed.config.ts --project=chrome --grep @host",
    "test:deployed:exports": "playwright test -c playwright.deployed.config.ts --project=chrome --grep @full tests/deployed/deployed-exports.spec.ts",
    "test:deployed:a11y": "playwright test -c playwright.deployed.config.ts --project=chrome --grep @full tests/deployed/deployed-a11y.spec.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/space-grotesk": "^5.2.6",
    "lucide-react": "^0.468.0",
    "mediabunny": "1.61.3",
    "motion": "^14.2.0",
    "pixi.js": "8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  }
}

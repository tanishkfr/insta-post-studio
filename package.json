{
  "name": "insta-post-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Studio 2.0 — a unified Instagram creative toolset built on preserved, standalone editors.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev --workspace @studio/host",
    "predev": "npm run tool:shapes:build && npm run tool:bend:build",
    "build": "npm run tool:shapes:build && npm run tool:bend:build && npm run build --workspace @studio/host",
    "preview": "npm run preview --workspace @studio/host",
    "test": "npm run test --workspace @studio/host",
    "pretest:browser": "npm run tool:shapes:build && npm run tool:bend:build",
    "test:browser": "npm run test:browser --workspace @studio/host",
    "pretest:browser:bend:production": "npm run build",
    "test:browser:bend:production": "npm run test:browser:bend:production --workspace @studio/host",
    "typecheck": "npm run contracts:typecheck && npm run typecheck --workspace @studio/host",
    "contracts:typecheck": "npm run typecheck --workspace @studio/contracts",
    "verify": "npm run contracts:typecheck && npm run build && npm test",
    "serve:legacy": "node scripts/serve-static.mjs tools/legacy 4173",
    "serve:typography": "node scripts/serve-static.mjs tools/typography 4174",
    "tool:shapes:install": "npm --prefix tools/shapes install",
    "tool:shapes:dev": "npm --prefix tools/shapes run dev",
    "tool:shapes:build": "npm --prefix tools/shapes run build",
    "tool:shapes:test": "npm --prefix tools/shapes test",
    "tool:bend:install": "npm --prefix tools/bend install",
    "tool:bend:dev": "npm --prefix tools/bend run dev",
    "tool:bend:typecheck": "npm --prefix tools/bend run typecheck",
    "tool:bend:test": "npm --prefix tools/bend test",
    "tool:bend:build": "node scripts/build-bend.mjs",
    "tool:bend:verify": "npm --prefix tools/bend run verify",
    "tool:bend:test:browser": "npm --prefix tools/bend run test:browser"
  }
}
